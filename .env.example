# Which provider to use: azure, openrouter or lmstudio (default: azure).
# Each provider reads its own three settings below. Fill in only the ones you use.
# To try another provider for one run:  LLM_PROVIDER=lmstudio python agent.py data/sales.csv
LLM_PROVIDER=azure

# Azure OpenAI (or any OpenAI-compatible endpoint)
AZURE_BASE_URL=<value>
AZURE_API_KEY=<value>
AZURE_MODEL=<value>

# OpenRouter. The model is a slug such as google/gemma-4-31b-it:free,
# or a preset of yours written as @preset/<name>
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=<value>
OPENROUTER_MODEL=<value>

# LM Studio (local server, start it in LM Studio). The key is ignored but must not be empty.
# The model is the name shown by http://localhost:1234/v1/models
LMSTUDIO_BASE_URL=http://localhost:1234/v1
LMSTUDIO_API_KEY=lm-studio
LMSTUDIO_MODEL=gemma-4-e4b-it

# Optional: price per 1M tokens, to print a cost estimate.
# Global, or per provider (AZURE_PRICE_INPUT_PER_M, ...). Local models cost nothing.
PRICE_INPUT_PER_M=0
PRICE_OUTPUT_PER_M=0
